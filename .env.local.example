# ============================================================
# AgentSystem 环境变量配置模板
#
# 【推荐方式】把 API key 写入运行时目录的 model.local.env：
#   ~/.local/share/agentsystem/model.local.env
#   格式：KEY=VALUE（一行一个），平台启动时自动加载，
#   无需在启动命令里手动 export。
#
#   # 例如：
#   FANGZHOU_API_KEY=sk-xxx
#   OPENAI_API_KEY=sk-xxx
#
# 【备用方式】在项目根目录创建 .env 文件，start.sh 会 source 它。
# ============================================================

# 主模型（仅当 config.yaml 缺失时才使用以下环境变量）
OPENAI_API_KEY=replace-with-your-real-key
OPENAI_BASE_URL=https://crs.ruinique.com
OPENAI_MODEL=gpt-5.4
